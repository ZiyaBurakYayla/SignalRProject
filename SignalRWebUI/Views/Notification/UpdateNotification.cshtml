@model UpdateNotificationDto
@{
    ViewData["Title"] = "Bildirim Güncelle";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .sahara-input {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid #d8d0c8;
        color: #3a302a;
        font-size: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }
    .sahara-input:focus {
        border-color: #c2652a;
        box-shadow: 0 0 0 1px #c2652a;
    }
    .sahara-shadow { box-shadow: 0 2px 16px rgba(58, 48, 42, 0.04); }
</style>

<main class="w-full max-w-3xl mx-auto p-4 sm:p-8">

    <header class="mb-10 text-center sm:text-left">
        <a asp-controller="Notification" asp-action="NotificationList"
           class="inline-flex items-center text-secondary hover:text-primary transition-colors text-sm font-medium mb-4">
            <span class="material-symbols-outlined mr-1" style="font-size: 18px;">arrow_back</span>
            Bildirimlere Dön
        </a>
        <h1 class="font-headline text-4xl sm:text-5xl font-semibold tracking-tight text-on-background mb-3">
            Bildirim Güncelle
        </h1>
        <p class="font-body text-lg text-on-surface-variant">Mevcut bildirim bilgilerini düzenleyin.</p>
    </header>

    <div class="bg-surface-container-low rounded-xl sahara-shadow border border-outline-variant/60 p-6 sm:p-10">
        <form asp-controller="Notification" asp-action="UpdateNotification" method="post" class="space-y-8">

            <input type="hidden" asp-for="NotificationId" />

            <div class="space-y-6">
                <h2 class="font-headline text-2xl font-medium text-primary border-b border-outline-variant/40 pb-2">
                    Bildirim Bilgileri
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                    <!-- Tür -->
                    <div>
                        <label asp-for="NotificationType" class="block font-label text-sm font-semibold text-on-surface mb-2">
                            Bildirim Türü
                        </label>
                        <select asp-for="NotificationType" class="sahara-input appearance-none">
                            <option value="info">Info</option>
                            <option value="success">Success</option>
                            <option value="warning">Warning</option>
                            <option value="error">Error</option>
                        </select>
                    </div>

                    <!-- İkon -->
                    <div>
                        <label asp-for="NotificationIcon" class="block font-label text-sm font-semibold text-on-surface mb-2">
                            İkon (Material Symbol)
                        </label>
                        <input asp-for="NotificationIcon" class="sahara-input" placeholder="Örn: notifications, info" />
                    </div>

                    <!-- Açıklama -->
                    <div class="sm:col-span-2">
                        <label asp-for="Description" class="block font-label text-sm font-semibold text-on-surface mb-2">
                            Açıklama
                        </label>
                        <input asp-for="Description" class="sahara-input" placeholder="Bildirim açıklaması" />
                        <span asp-validation-for="Description" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <!-- Tarih -->
                    <div>
                        <label asp-for="NotificationDate" class="block font-label text-sm font-semibold text-on-surface mb-2">
                            Tarih
                        </label>
                        <input asp-for="NotificationDate" class="sahara-input" type="datetime-local"
                               value="@(Model?.NotificationDate.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>

                    <!-- Durum -->
                    <div>
                        <label asp-for="Status" class="block font-label text-sm font-semibold text-on-surface mb-2">
                            Durum
                        </label>
                        <select asp-for="Status" class="sahara-input appearance-none">
                            <option value="false" selected="@(Model != null && !Model.Status)">Yeni (Okunmadı)</option>
                            <option value="true" selected="@(Model != null && Model.Status)">Okundu</option>
                        </select>
                    </div>

                </div>
            </div>

            <div class="pt-6 flex flex-col sm:flex-row items-center justify-end gap-4 border-t border-outline-variant/40">
                <a asp-controller="Notification" asp-action="NotificationList"
                   class="w-full sm:w-auto px-8 py-3 rounded-lg border border-outline-variant text-on-surface font-label font-semibold hover:bg-surface-container-high transition-colors text-center">
                    Vazgeç
                </a>
                <button type="submit"
                        class="w-full sm:w-auto px-8 py-3 rounded-lg bg-primary text-on-primary font-label font-semibold hover:bg-on-primary-fixed-variant transition-colors shadow-sm">
                    Güncelle
                </button>
            </div>

        </form>
    </div>

</main>
