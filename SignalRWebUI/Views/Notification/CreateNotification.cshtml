@model CreateNotificationDto
@{
    ViewData["Title"] = "Yeni Bildirim Ekle";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .sahara-input {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid rgba(216, 208, 200, 0.6);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        color: #3a302a;
        font-family: 'Manrope', sans-serif;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .sahara-input:focus {
        border-color: #c2652a;
        box-shadow: 0 0 0 2px rgba(194,101,42,0.2);
    }
</style>

<main class="w-full max-w-3xl mx-auto p-4 md:p-8">

    <header class="mb-10 text-center md:text-left">
        <a asp-controller="Notification" asp-action="NotificationList"
           class="inline-flex items-center text-secondary hover:text-primary transition-colors text-sm font-medium mb-4">
            <span class="material-symbols-outlined mr-1" style="font-size: 18px;">arrow_back</span>
            Bildirimlere Dön
        </a>
        <h1 class="font-headline text-4xl md:text-5xl font-semibold text-on-background mb-3 tracking-tight">
            Yeni Bildirim Ekle
        </h1>
        <p class="font-body text-on-surface-variant text-lg">Sisteme yeni bir bildirim kaydı girin.</p>
    </header>

    <div class="bg-surface-container-low rounded-xl border border-outline-variant/30 p-6 md:p-10"
         style="box-shadow: 0 2px 16px rgba(58,48,42,0.04);">

        <form asp-controller="Notification" asp-action="CreateNotification" method="post" class="space-y-8">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                <!-- Tür -->
                <div>
                    <label asp-for="NotificationType" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        Bildirim Türü <span class="text-error">*</span>
                    </label>
                    <select asp-for="NotificationType" class="sahara-input appearance-none">
                        <option value="">Tür seçin</option>
                        <option value="info">Info</option>
                        <option value="success">Success</option>
                        <option value="warning">Warning</option>
                        <option value="error">Error</option>
                    </select>
                    <span asp-validation-for="NotificationType" class="text-error text-xs mt-1 block"></span>
                </div>

                <!-- İkon -->
                <div>
                    <label asp-for="NotificationIcon" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        İkon (Material Symbol) <span class="text-error">*</span>
                    </label>
                    <input asp-for="NotificationIcon" class="sahara-input" placeholder="Örn: notifications, info, warning" />
                    <span asp-validation-for="NotificationIcon" class="text-error text-xs mt-1 block"></span>
                </div>

                <!-- Açıklama -->
                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        Açıklama <span class="text-error">*</span>
                    </label>
                    <input asp-for="Description" class="sahara-input" placeholder="Bildirim açıklaması" />
                    <span asp-validation-for="Description" class="text-error text-xs mt-1 block"></span>
                </div>

                <!-- Tarih -->
                <div>
                    <label asp-for="NotificationDate" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        Tarih <span class="text-error">*</span>
                    </label>
                    <input asp-for="NotificationDate" class="sahara-input" type="datetime-local" id="dateInput" />
                    <span asp-validation-for="NotificationDate" class="text-error text-xs mt-1 block"></span>
                </div>

                <!-- Durum -->
                <div>
                    <label class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">Durum</label>
                    <select asp-for="Status" class="sahara-input appearance-none">
                        <option value="false">Yeni (Okunmadı)</option>
                        <option value="true">Okundu</option>
                    </select>
                </div>

            </div>

            <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-4 pt-6 mt-8 border-t border-outline-variant/40">
                <a asp-controller="Notification" asp-action="NotificationList"
                   class="w-full sm:w-auto px-6 py-3 font-label font-bold text-on-surface-variant hover:text-on-background border border-outline-variant/60 hover:bg-surface-container-highest rounded-lg transition-colors duration-200 text-center">
                    Vazgeç
                </a>
                <button type="submit"
                        class="w-full sm:w-auto px-8 py-3 font-label font-bold text-on-primary bg-primary hover:bg-on-primary-fixed-variant rounded-lg shadow-sm transition-colors duration-200 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1; font-size: 18px;">check_circle</span>
                    Kaydet
                </button>
            </div>

        </form>
    </div>

</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var dateInput = document.getElementById('dateInput');
        if (dateInput && !dateInput.value) {
            var now = new Date();
            var pad = function (n) { return String(n).padStart(2, '0'); };
            dateInput.value = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate())
                + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());
        }
    });
</script>
