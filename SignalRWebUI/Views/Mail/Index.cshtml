@model SignalRWebUI.Dtos.MailDtos.CreateMailDto
@{
    ViewData["Title"] = "E-posta Gönder";
}

<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />

<style>
    #quill-editor  { min-height: 260px; font-family: 'Manrope', sans-serif; font-size: 0.875rem; color: #3a302a; }
    .ql-toolbar    { border-radius: 0.5rem 0.5rem 0 0 !important; border-color: #d8d0c8 !important; background: #f6f0e8; }
    .ql-container  { border-radius: 0 0 0.5rem 0.5rem !important; border-color: #d8d0c8 !important; background: #ffffff; }
    .ql-editor.ql-blank::before { color: #9a9088 !important; font-style: normal !important; }
</style>

<div class="admin-page">

    <!-- Header -->
    <header class="admin-header">
        <div>
            <p class="admin-badge">Sahara Admin</p>
            <h1 class="admin-title">E-posta Gönder</h1>
            <p class="admin-subtitle">Müşterilerinize veya personelinize e-posta gönderin.</p>
        </div>
    </header>

    <!-- Form Card -->
    <div class="bg-surface-container-low rounded-xl border border-outline-variant/60 shadow-[0_2px_16px_rgba(58,48,42,0.04)] overflow-hidden">

        <div class="p-6 border-b border-outline-variant/60 bg-surface-container/50">
            <h2 class="font-label font-semibold text-sm text-on-surface-variant">Yeni Mesaj</h2>
        </div>

        <form asp-action="Index" asp-controller="Mail" method="post" id="mail-form" class="p-6 space-y-6">
            @Html.AntiForgeryToken()

            <!-- Alıcı & Konu -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                    <label asp-for="ReceiverMail" class="text-sm font-semibold text-on-surface">Alıcı E-posta</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-secondary pointer-events-none">
                            <span class="material-symbols-outlined text-lg">mail</span>
                        </span>
                        <input asp-for="ReceiverMail" type="email" placeholder="ornek@alanadi.com" required
                               class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all placeholder:text-on-surface-variant/50" />
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <label asp-for="Subject" class="text-sm font-semibold text-on-surface">Konu</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-secondary pointer-events-none">
                            <span class="material-symbols-outlined text-lg">subtitles</span>
                        </span>
                        <input asp-for="Subject" type="text" placeholder="E-posta konusu..." required
                               class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all placeholder:text-on-surface-variant/50" />
                    </div>
                </div>
            </div>

            <!-- Mesaj -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-on-surface">Mesaj İçeriği</label>
                <div id="quill-editor"></div>
                <input type="hidden" asp-for="Body" id="body-input" />
            </div>

            <!-- Gönder -->
            <div class="flex justify-end pt-2">
                <button type="submit"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-on-primary rounded-lg font-semibold text-sm hover:opacity-90 transition-opacity shadow-sm">
                    <span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1">send</span>
                    Gönder
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    var quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: 'Mesajınızı buraya yazın...',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'color': [] }, { 'background': [] }],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                [{ 'align': [] }],
                ['link'],
                ['clean']
            ]
        }
    });

    document.getElementById('mail-form').addEventListener('submit', function () {
        document.getElementById('body-input').value = quill.root.innerHTML;
    });
</script>
}
