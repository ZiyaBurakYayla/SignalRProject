@model CreateCategoryDto
@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
</style>

<main class="max-w-4xl mx-auto px-6 py-12 md:px-12 md:py-16">

    <!-- Header -->
    <header class="mb-12">
        <nav aria-label="Breadcrumb" class="flex items-center text-sm font-label text-secondary mb-4">
            <a asp-controller="Category" asp-action="CategoryList" class="hover:text-primary transition-colors">Kategoriler</a>
            <span class="material-symbols-outlined text-sm mx-2">chevron_right</span>
            <span class="text-on-surface">Yeni Kategori Ekle</span>
        </nav>
        <h1 class="font-headline text-4xl md:text-5xl font-medium tracking-tight text-on-surface">Yeni Kategori Ekle</h1>
        <p class="font-body text-on-surface-variant mt-3 max-w-2xl text-lg">
            Menü öğelerinizi düzenlemek için yeni bir kategori oluşturun. Misafirlerinizin tekliflerinizde gezinmesine yardımcı olun.
        </p>
    </header>

    <!-- Form Card -->
    <div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_16px_rgba(58,48,42,0.04)] border border-outline-variant/60 overflow-hidden">
        <div class="p-8 md:p-10">
            <form asp-controller="Category" asp-action="CreateCategory" method="post" class="space-y-8">

                <!-- Section Title -->
                <div class="border-b border-outline-variant/60 pb-4 mb-6">
                    <h2 class="font-headline text-2xl font-medium text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">category</span>
                        Kategori Bilgileri
                    </h2>
                </div>

                <!-- Input Grid -->
                <div class="grid grid-cols-1 gap-6 max-w-2xl">

                    <!-- Kategori Adı -->
                    <div>
                        <label asp-for="CategoryName" class="block font-label text-sm font-semibold text-on-surface mb-2">
                            Kategori Adı <span class="text-error">*</span>
                        </label>
                        <input asp-for="CategoryName"
                               class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-surface-bright text-on-surface font-body focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-shadow placeholder:text-outline"
                               placeholder="Örn: Başlangıçlar, Ana Yemekler" />
                        <p class="font-body text-xs text-secondary mt-2">Menüde görünecek olan ana kategori ismi.</p>
                        <span asp-validation-for="CategoryName" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <!-- Kategori Durumu -->
                    <div class="pt-4">
                        <label class="block font-label text-sm font-semibold text-on-surface mb-3">Kategori Durumu</label>
                        <div class="flex items-center gap-6 bg-surface-container-low p-4 rounded-lg border border-outline-variant/40">

                            <!-- Aktif -->
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <div class="relative flex items-center">
                                    <input type="radio" name="CategoryStatus" value="true" checked
                                           class="peer sr-only" />
                                    <div class="w-5 h-5 rounded-full border border-outline peer-checked:border-primary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-on-surface group-hover:text-primary transition-colors">Aktif</span>
                            </label>

                            <!-- Pasif -->
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <div class="relative flex items-center">
                                    <input type="radio" name="CategoryStatus" value="false"
                                           class="peer sr-only" />
                                    <div class="w-5 h-5 rounded-full border border-outline peer-checked:border-secondary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-secondary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-secondary group-hover:text-on-surface transition-colors">Pasif</span>
                            </label>

                        </div>
                        <p class="font-body text-xs text-secondary mt-2">Pasif kategoriler menüde müşterilere gösterilmez.</p>
                    </div>

                </div>

                <!-- Actions -->
                <div class="pt-8 border-t border-outline-variant/60 flex items-center gap-4 mt-10">
                    <button type="submit"
                            class="bg-primary text-on-primary font-label font-medium px-8 py-3 rounded-lg hover:bg-on-primary-fixed-variant transition-colors duration-200 shadow-sm flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">check</span>
                        Kaydet
                    </button>
                    <a asp-controller="Category" asp-action="CategoryList"
                       class="bg-transparent border border-outline-variant text-on-surface font-label font-medium px-8 py-3 rounded-lg hover:bg-surface-container-low hover:border-outline transition-colors duration-200">
                        Vazgeç
                    </a>
                </div>

            </form>
        </div>
    </div>

</main>
