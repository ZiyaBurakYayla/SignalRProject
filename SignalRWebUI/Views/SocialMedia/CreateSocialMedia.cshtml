@model CreateSocialMediaDto
@{
    ViewData["Title"] = "Yeni Sosyal Medya Ekle";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
</style>

<main class="w-full max-w-2xl mx-auto bg-surface-container-low rounded-xl p-8 md:p-12 shadow-[0_2px_16px_rgba(58,48,42,0.04)] border border-outline-variant/60 my-10">

    <header class="mb-10 text-center">
        <h1 class="font-headline text-4xl md:text-5xl font-bold text-on-surface mb-3 tracking-tight">
            Yeni Sosyal Medya Ekle
        </h1>
        <p class="font-body text-on-surface-variant text-base md:text-lg">
            Platformunuzu genişletin ve ağlarınızı bağlayın.
        </p>
    </header>

    <form asp-controller="SocialMedia" asp-action="CreateSocialMedia" method="post" class="space-y-8">
        <div class="space-y-6">

            <!-- Başlık -->
            <div class="flex flex-col space-y-2">
                <label asp-for="Title" class="font-label text-sm font-semibold text-on-surface">Başlık</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">title</span>
                    <input asp-for="Title"
                           class="w-full bg-surface-container-lowest border border-outline-variant/60 text-on-surface rounded-lg pl-10 pr-4 py-3 font-body focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-shadow placeholder:text-on-surface-variant/50 shadow-sm"
                           placeholder="Örn: Instagram" />
                </div>
                <span asp-validation-for="Title" class="text-error text-xs"></span>
            </div>

            <!-- URL -->
            <div class="flex flex-col space-y-2">
                <label asp-for="Url" class="font-label text-sm font-semibold text-on-surface">Bağlantı (URL)</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">link</span>
                    <input asp-for="Url" type="url"
                           class="w-full bg-surface-container-lowest border border-outline-variant/60 text-on-surface rounded-lg pl-10 pr-4 py-3 font-body focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-shadow placeholder:text-on-surface-variant/50 shadow-sm"
                           placeholder="https://instagram.com/hesabim" />
                </div>
                <span asp-validation-for="Url" class="text-error text-xs"></span>
            </div>

            <!-- İkon -->
            <div class="flex flex-col space-y-2">
                <label asp-for="Icon" class="font-label text-sm font-semibold text-on-surface">İkon Adı (Material Symbols)</label>
                <div class="relative">
                    <span id="iconPreview" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">image</span>
                    <input asp-for="Icon" id="iconInput"
                           class="w-full bg-surface-container-lowest border border-outline-variant/60 text-on-surface rounded-lg pl-10 pr-4 py-3 font-body focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-shadow placeholder:text-on-surface-variant/50 shadow-sm"
                           placeholder="Örn: camera_alt" />
                </div>
                <p class="text-xs text-on-surface-variant">Lütfen geçerli bir Material Symbol adı giriniz. İkon canlı önizlemesi solda görünür.</p>
                <span asp-validation-for="Icon" class="text-error text-xs"></span>
            </div>

            <!-- Durum -->
            <div class="flex flex-col space-y-2">
                <label class="font-label text-sm font-semibold text-on-surface">Durum</label>
                <div class="flex items-center space-x-6 mt-2">
                    <label class="flex items-center space-x-3 cursor-pointer group">
                        <input asp-for="Status" type="checkbox" value="true"
                               class="form-checkbox text-primary border-outline-variant/60 focus:ring-primary h-5 w-5 rounded" />
                        <span class="font-body text-on-surface group-hover:text-primary transition-colors">Aktif</span>
                    </label>
                </div>
            </div>

        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end space-x-4 pt-6 border-t border-outline-variant/40 mt-10">
            <a asp-controller="SocialMedia" asp-action="SocialMediaList"
               class="px-6 py-2.5 rounded-lg border border-outline-variant/60 text-on-surface font-label font-medium hover:bg-surface-variant/50 transition-colors">
                Vazgeç
            </a>
            <button type="submit"
                    class="px-6 py-2.5 rounded-lg bg-primary text-on-primary font-label font-medium hover:bg-on-primary-fixed-variant transition-colors shadow-sm flex items-center space-x-2">
                <span class="material-symbols-outlined text-[20px]">save</span>
                <span>Kaydet</span>
            </button>
        </div>

    </form>

</main>

<script>
    const iconInput = document.getElementById('iconInput');
    const iconPreview = document.getElementById('iconPreview');

    iconInput.addEventListener('input', function () {
        const val = this.value.trim();
        iconPreview.textContent = val || 'image';
    });
</script>
