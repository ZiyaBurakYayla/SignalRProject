@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script type="text/javascript">
        (function () {
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("https://localhost:7196/signalrhub")
                .build();

            function updateConnStatus(state) {
                var dot = document.getElementById("connDot");
                var label = document.getElementById("connstatus");
                label.innerText = state;
                if (state === "Connected") {
                    dot.style.background = "#22c55e";
                } else if (state.startsWith("Hata")) {
                    dot.style.background = "#c0392b";
                } else {
                    dot.style.background = "#9a9088";
                }
            }

            updateConnStatus(connection.state);

            connection.on("ReceiveCategoryCount", function (value) {
                document.getElementById("categoryCount").innerText = value;
            });

            connection.on("ReceiveProductCount", function (value) {
                document.getElementById("productCount").innerText = value;
            });

            connection.on("ReceiveActiveCategoryCount", function (value) {
                document.getElementById("activeCategoryCount").innerText = value;
            });

            connection.on("ReceivePassiveCategoryCount", function (value) {
                document.getElementById("passiveCategoryCount").innerText = value;
            });

            connection.on("ReceiveProductCountByCategoryNameHamburger", function (value) {
                document.getElementById("CountByCategoryNameHamburger").innerText = value;
            });

            connection.on("ReceiveProductCountByCategoryNameDrinks", function (value) {
                document.getElementById("CountByCategoryNameDrinks").innerText = value;
            });

            connection.on("ReceiveAverageProductPrice", function (value) {
                document.getElementById("AverageProductPrice").innerText = value;
            });

            connection.on("ReceiveHighestPriceProductName", function (value) {
                document.getElementById("HighestPriceProductName").innerText = value;
            });

            connection.on("ReceiveLowestPriceProductName", function (value) {
                document.getElementById("LowestPriceProductName").innerText = value;
            });

            connection.on("ReceiveAveragePriceByCategoryNameHamburger", function (value) {
                document.getElementById("AveragePriceByCategoryNameHamburger").innerText = value;
            });

            connection.on("ReceiveTotalOrderCount", function (value) {
                document.getElementById("TotalOrderCount").innerText = value;
            });

            connection.on("ReceiveActiveOrderCount", function (value) {
                document.getElementById("ActiveOrderCount").innerText = value;
            });

            connection.on("ReceiveLastOrderPrice", function (value) {
                document.getElementById("LastOrderPrice").innerText = value;
            });

            connection.on("ReceiveTotalMoneyCaseAmount", function (value) {
                document.getElementById("TotalMoneyCaseAmount").innerText = value;
            });

            connection.on("ReceiveTodayTotalPrice", function (value) {
                document.getElementById("TodayTotalPrice").innerText = value;
            });

            connection.on("ReceiveOrderTableCount", function (value) {
                document.getElementById("OrderTableCount").innerText = value;
            });

            connection.start().then(function () {
                updateConnStatus("Connected");
                connection.invoke("SendStatistic");

                setInterval(function () {
                    connection.invoke("SendStatistic");
                }, 1000);

            }).catch(function (err) {
                updateConnStatus("Hata: " + err.toString());
                console.error(err);
            });

        })();
    </script>
}
