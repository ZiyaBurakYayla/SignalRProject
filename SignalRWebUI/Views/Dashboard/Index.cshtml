@{
    ViewData["Title"] = "Genel Bakış";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.4; }
    }

    .skeleton {
        animation: pulse 1.5s ease-in-out infinite;
        background: #ece6dc;
        border-radius: 0.25rem;
        display: inline-block;
    }
</style>

<main class="admin-page">

    <!-- Header Section -->
    <header class="admin-header">
        <div>
            <p class="admin-badge">Sahara Admin</p>
            <h1 class="admin-title">Genel Bakış</h1>
            <p class="admin-subtitle">Anlık performans göstergeleri ve istatistikler.</p>
        </div>
        <!-- Bağlantı durumu -->
        <div class="flex items-center gap-2">
            <span id="connDot" class="inline-block w-2.5 h-2.5 rounded-full bg-gray-400 transition-colors duration-500"></span>
            <span id="connstatus" class="text-sm text-text-muted font-sans">Bağlanıyor...</span>
        </div>
    </header>

    <!-- 4x4 Widget Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

        <!-- Widget 1: Kategori Sayısı -->
        <div class="flex flex-col justify-between p-6 rounded-xl bg-surface border border-border shadow-sm hover:shadow-md transition-shadow duration-300">
            <div class="flex justify-between items-start mb-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-text-muted font-sans">Kategori Sayısı</span>
                <span class="material-symbols-outlined text-primary">category</span>
            </div>
            <div>
                <h3 class="font-['EB_Garamond'] text-4xl font-semibold text-text mb-1" id="categoryCount">
                    <span class="skeleton w-16 h-8">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                </h3>
                <div class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm text-primary" style="font-size:16px">trending_up</span>
                    <span class="text-xs text-text-muted font-sans">Canlı veri</span>
                </div>
            </div>
        </div>

        <!-- Widget 2: Ürün Sayısı -->
        <div class="flex flex-col justify-between p-6 rounded-xl bg-surface border border-border shadow-sm hover:shadow-md transition-shadow duration-300">
            <div class="flex justify-between items-start mb-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-text-muted font-sans">Ürün Sayısı</span>
                <span class="material-symbols-outlined text-primary">restaurant_menu</span>
            </div>
            <div>
                <h3 class="font-['EB_Garamond'] text-4xl font-semibold text-text mb-1" id="productCount">
                    <span class="skeleton w-16 h-8">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                </h3>
                <div class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm text-primary" style="font-size:16px">trending_up</span>
                    <span class="text-xs text-text-muted font-sans">Canlı veri</span>
                </div>
            </div>
        </div>

        <!-- Widget 3: Aktif Kategori -->
        <div class="flex flex-col justify-between p-6 rounded-xl bg-surface border border-border shadow-sm hover:shadow-md transition-shadow duration-300">
            <div class="flex justify-between items-start mb-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-text-muted font-sans">Aktif Kategori</span>
