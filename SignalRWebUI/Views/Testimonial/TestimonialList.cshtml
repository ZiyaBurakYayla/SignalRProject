@model List<ResultTestimonialDto>
@{
    ViewData["Title"] = "Müşteri Yorumları";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .soft-shadow { box-shadow: 0 2px 16px rgba(58, 48, 42, 0.04); }
</style>

<main class="admin-page">

    <!-- Header -->
    <header class="admin-header">
        <div>
            <p class="admin-badge">Sahara Admin</p>
            <h1 class="admin-title">Müşteri Yorumları Yönetimi</h1>
            <p class="admin-subtitle">Müşterilerinizden gelen geri bildirimleri görüntüleyin ve yönetin.</p>
        </div>
        <a asp-controller="Testimonial" asp-action="CreateTestimonial" class="admin-btn-add">
            <span class="material-symbols-outlined">add</span>
            Yeni Yorum Ekle
        </a>
    </header>

    <!-- Table -->
    <div class="bg-surface-container-low rounded-xl soft-shadow border border-outline-variant/30 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container border-b border-outline-variant/40">
                        <th class="py-4 px-6 font-headline text-lg font-medium text-on-surface">Görsel</th>
                        <th class="py-4 px-6 font-headline text-lg font-medium text-on-surface">İsim & Başlık</th>
                        <th class="py-4 px-6 font-headline text-lg font-medium text-on-surface w-1/3">Yorum</th>
                        <th class="py-4 px-6 font-headline text-lg font-medium text-on-surface">Durum</th>
                        <th class="py-4 px-6 font-headline text-lg font-medium text-on-surface text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/20 font-body text-on-surface-variant">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-surface-container-high transition-colors duration-150">

                                <!-- Görsel -->
                                <td class="py-4 px-6">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name"
                                             class="w-12 h-12 rounded-full object-cover border border-outline-variant/40" />
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center border border-outline-variant/40">
                                            <span class="material-symbols-outlined text-on-surface-variant text-[20px]">person</span>
                                        </div>
                                    }
                                </td>

                                <!-- İsim & Başlık -->
                                <td class="py-4 px-6">
                                    <div class="font-medium text-on-surface">@item.Name</div>
                                    <div class="text-sm text-secondary">@item.Title</div>
                                </td>

                                <!-- Yorum -->
                                <td class="py-4 px-6">
                                    <p class="truncate max-w-[250px] lg:max-w-md" title="@item.Comment">@item.Comment</p>
                                </td>

                                <!-- Durum -->
                                <td class="py-4 px-6">
                                    @if (item.Status)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-container text-on-primary-fixed">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-surface-container-highest text-on-surface-variant">Pasif</span>
                                    }
                                </td>

                                <!-- İşlemler -->
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-controller="Testimonial" asp-action="UpdateTestimonial" asp-route-id="@item.TestimonialId"
                                           class="p-2 text-secondary hover:text-primary transition-colors rounded-lg hover:bg-surface-container" title="Düzenle">
                                            <span class="material-symbols-outlined text-[20px]">edit</span>
                                        </a>
                                        <a asp-controller="Testimonial" asp-action="DeleteTestimonial" asp-route-id="@item.TestimonialId"
                                           class="p-2 text-secondary hover:text-error transition-colors rounded-lg hover:bg-surface-container" title="Sil">
                                            <span class="material-symbols-outlined text-[20px]">delete</span>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-20 text-center">
                                <div class="flex flex-col items-center justify-center text-secondary gap-3">
                                    <span class="material-symbols-outlined text-[3rem] opacity-40">chat_bubble</span>
                                    <p class="font-label text-sm">Henüz müşteri yorumu bulunmuyor.</p>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="flex items-center justify-between px-6 py-4 bg-surface-container border-t border-outline-variant/40">
            <span class="text-sm text-on-surface-variant">
                Toplam <span class="font-medium text-on-surface">@(Model?.Count ?? 0)</span> yorum gösteriliyor.
            </span>
            <div class="flex gap-1">
                <button class="p-1 rounded text-secondary hover:bg-surface-container-highest hover:text-primary transition-colors disabled:opacity-50" disabled>
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <button class="p-1 rounded text-secondary hover:bg-surface-container-highest hover:text-primary transition-colors disabled:opacity-50" disabled>
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </div>
    </div>

</main>
