@model UpdateTestimonialDto
@{
    ViewData["Title"] = "Müşteri Yorumunu Güncelle";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .soft-shadow { box-shadow: 0 2px 16px rgba(58, 48, 42, 0.04); }
</style>

<main class="w-full max-w-3xl mx-auto py-10 px-6">

    <!-- Header -->
    <header class="mb-10 text-center md:text-left">
        <a asp-controller="Testimonial" asp-action="TestimonialList"
           class="inline-flex items-center text-secondary hover:text-primary transition-colors text-sm font-medium mb-4">
            <span class="material-symbols-outlined mr-1" style="font-size: 18px;">arrow_back</span>
            Yorumlara Dön
        </a>
        <h1 class="text-4xl md:text-5xl font-medium text-on-surface mb-2 tracking-tight">Müşteri Yorumunu Güncelle</h1>
        <p class="text-on-surface-variant text-lg font-body">Mevcut yorum detaylarını ve durumunu düzenleyin.</p>
    </header>

    <!-- Form Card -->
    <div class="bg-surface-container-low rounded-xl soft-shadow border border-outline-variant/60 p-8 md:p-10">
        <form asp-controller="Testimonial" asp-action="UpdateTestimonial" method="post" class="space-y-8">

            <input type="hidden" asp-for="TestimonialId" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                <!-- Sol: Avatar + Durum -->
                <div class="space-y-8">

                    <!-- Görsel Önizleme -->
                    <div class="flex flex-col items-start gap-4">
                        <label class="block text-sm font-medium text-on-surface-variant font-label">Müşteri Görseli (URL)</label>
                        <div class="flex items-center gap-4">
                            @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                            {
                                <img id="avatarPreview" src="@Model.ImageUrl" alt="@Model.Name"
                                     class="w-20 h-20 rounded-full object-cover border-2 border-surface-container-high soft-shadow" />
                            }
                            else
                            {
                                <div id="avatarFallback" class="w-20 h-20 rounded-full bg-surface-container-high flex items-center justify-center border-2 border-surface-container-high">
                                    <span class="material-symbols-outlined text-on-surface-variant text-[32px]">person</span>
                                </div>
                            }
                        </div>
                        <div class="relative w-full">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" style="font-size: 18px;">link</span>
                            <input asp-for="ImageUrl" id="imageUrlInput"
                                   class="w-full bg-surface-container-lowest border border-outline-variant text-on-surface rounded-lg pl-9 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors placeholder:text-on-surface-variant/50"
                                   placeholder="https://..." />
                        </div>
                    </div>

                    <!-- Durum -->
                    <div>
                        <label class="block text-sm font-medium text-on-surface-variant font-label mb-2">Yayın Durumu</label>
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <input asp-for="Status" type="checkbox"
                                   class="form-checkbox text-primary border-outline-variant focus:ring-primary h-5 w-5 rounded bg-surface-container-lowest" />
                            <span class="text-on-surface font-body group-hover:text-primary transition-colors">Aktif — Testimonials sayfasında göster</span>
                        </label>
                    </div>

                </div>

                <!-- Sağ: Metin Alanları -->
                <div class="space-y-6">

                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-on-surface-variant font-label mb-2">Müşteri Adı</label>
                        <input asp-for="Name"
                               class="block w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface focus:border-primary focus:ring-1 focus:ring-primary transition-colors outline-none"
                               placeholder="İsim Soyisim" />
                        <span asp-validation-for="Name" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Title" class="block text-sm font-medium text-on-surface-variant font-label mb-2">Ünvan / Açıklama</label>
                        <input asp-for="Title"
                               class="block w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface focus:border-primary focus:ring-1 focus:ring-primary transition-colors outline-none"
                               placeholder="Örn: Gurme Yazar" />
                    </div>

                </div>

            </div>

            <!-- Yorum -->
            <div class="pt-2">
                <label asp-for="Comment" class="block text-sm font-medium text-on-surface-variant font-label mb-2">Yorum Metni</label>
                <textarea asp-for="Comment" rows="4"
                          class="block w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-y outline-none"
                          placeholder="Müşteri yorumu..."></textarea>
                <p class="mt-2 text-sm text-secondary font-body">Kısa ve öz yorumlar vitrinde daha iyi görünür.</p>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-4 pt-6 border-t border-outline-variant/60">
                <a asp-controller="Testimonial" asp-action="TestimonialList"
                   class="px-6 py-3 rounded-lg border border-outline-variant text-on-surface font-semibold hover:bg-surface-container transition-colors">
                    Vazgeç
                </a>
                <button type="submit"
                        class="px-8 py-3 rounded-lg bg-primary text-on-primary font-semibold shadow-sm hover:bg-on-primary-fixed-variant transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">save</span>
                    Güncelle
                </button>
            </div>

        </form>
    </div>

</main>

<script>
    const imageUrlInput = document.getElementById('imageUrlInput');

    imageUrlInput.addEventListener('input', function () {
        const url = this.value.trim();
        let preview = document.getElementById('avatarPreview');
        const fallback = document.getElementById('avatarFallback');

        if (url.length > 10) {
            if (!preview) {
                // Avatar yok, oluştur
                preview = document.createElement('img');
                preview.id = 'avatarPreview';
                preview.alt = 'Önizleme';
                preview.className = 'w-20 h-20 rounded-full object-cover border-2 border-surface-container-high';
                if (fallback) fallback.replaceWith(preview);
            }
            preview.src = url;
            preview.onerror = () => { preview.src = ''; };
        }
    });
</script>
