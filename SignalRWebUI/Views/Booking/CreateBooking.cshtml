@model CreateBookingDto
@{
    ViewData["Title"] = "Yeni Rezervasyon Ekle";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .sahara-input {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid rgba(216, 208, 200, 0.6);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        color: #3a302a;
        font-family: 'Manrope', sans-serif;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    /* İkon olan inputlar için sol padding */
    .sahara-input.with-icon {
        padding-left: 2.75rem;
    }
    .sahara-input:focus {
        border-color: #c2652a;
        box-shadow: 0 0 0 2px rgba(194,101,42,0.2);
    }
</style>

<main class="w-full max-w-3xl mx-auto p-4 md:p-8">

    <!-- Header -->
    <header class="mb-10 text-center md:text-left">
        <a asp-controller="Booking" asp-action="BookingList"
           class="inline-flex items-center text-secondary hover:text-primary transition-colors text-sm font-medium mb-4">
            <span class="material-symbols-outlined mr-1" style="font-size: 18px;">arrow_back</span>
            Rezervasyonlara Dön
        </a>
        <h1 class="font-headline text-4xl md:text-5xl font-semibold text-on-background mb-3 tracking-tight">
            Yeni Rezervasyon Ekle
        </h1>
        <p class="font-body text-on-surface-variant text-lg">Yeni bir rezervasyon kaydı girin.</p>
    </header>

    <!-- Form Card -->
    <div class="bg-surface-container-low rounded-xl border border-outline-variant/30 p-6 md:p-10"
         style="box-shadow: 0 2px 16px rgba(58,48,42,0.04);">

        <form asp-controller="Booking" asp-action="CreateBooking" method="post" class="space-y-8">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                <!-- Ad Soyad -->
                <div>
                    <label asp-for="Name" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        Ad Soyad <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" style="font-size: 20px;">person</span>
                        <input asp-for="Name" class="sahara-input with-icon" placeholder="Örn: Ayşe Yılmaz" />
                    </div>
                    <span asp-validation-for="Name" class="text-error text-xs mt-1 block"></span>
                </div>

                <!-- Telefon -->
                <div>
                    <label asp-for="PhoneNO" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        Telefon Numarası <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" style="font-size: 20px;">phone</span>
                        <input asp-for="PhoneNO" class="sahara-input with-icon" type="tel" placeholder="05XX XXX XX XX" />
                    </div>
                    <span asp-validation-for="PhoneNO" class="text-error text-xs mt-1 block"></span>
                </div>

                <!-- E-posta -->
                <div>
                    <label asp-for="Mail" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        E-posta Adresi <span class="text-secondary font-normal">(İsteğe Bağlı)</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" style="font-size: 20px;">mail</span>
                        <input asp-for="Mail" class="sahara-input with-icon" type="email" placeholder="ornek@email.com" />
                    </div>
                </div>

                <!-- Kişi Sayısı -->
                <div>
                    <label asp-for="PersonCount" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        Kişi Sayısı <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" style="font-size: 20px;">group</span>
                        <select asp-for="PersonCount" class="sahara-input with-icon appearance-none pr-10">
                            <option value="">Kişi sayısı seçin</option>
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">@i Kişi</option>
                            }
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-on-surface-variant">
                            <span class="material-symbols-outlined" style="font-size: 20px;">expand_more</span>
                        </div>
                    </div>
                    <span asp-validation-for="PersonCount" class="text-error text-xs mt-1 block"></span>
                </div>

                <!-- Tarih ve Saat -->
                <div class="md:col-span-2">
                    <label asp-for="Date" class="block text-sm font-semibold text-on-surface-variant mb-2 font-label">
                        Tarih ve Saat <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none" style="font-size: 20px;">calendar_today</span>
                        <input asp-for="Date" class="sahara-input with-icon" type="datetime-local" id="dateInput" />
                    </div>
                    <span asp-validation-for="Date" class="text-error text-xs mt-1 block"></span>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-4 pt-6 mt-8 border-t border-outline-variant/40">
                <a asp-controller="Booking" asp-action="BookingList"
                   class="w-full sm:w-auto px-6 py-3 font-label font-bold text-on-surface-variant hover:text-on-background border border-outline-variant/60 hover:bg-surface-container-highest rounded-lg transition-colors duration-200 text-center">
                    Vazgeç
                </a>
                <button type="submit"
                        class="w-full sm:w-auto px-8 py-3 font-label font-bold text-on-primary bg-primary hover:bg-on-primary-fixed-variant rounded-lg shadow-sm transition-colors duration-200 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1; font-size: 18px;">check_circle</span>
                    Kaydet
                </button>
            </div>

        </form>
    </div>

</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const dateInput = document.getElementById('dateInput');
        if (dateInput && !dateInput.value) {
            const now = new Date();
            now.setHours(now.getHours() + 1);
            now.setMinutes(0, 0, 0);
            const pad = n => String(n).padStart(2, '0');
            dateInput.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:00`;
        }
    });
</script>
