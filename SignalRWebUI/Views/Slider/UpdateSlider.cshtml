@model UpdateSliderDto
@{
    ViewData["Title"] = "Slider Güncelle";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
</style>

<main class="max-w-4xl mx-auto px-6 py-16">

    <!-- Header -->
    <div class="mb-12">
        <a asp-controller="Slider" asp-action="SliderList"
           class="inline-flex items-center gap-2 text-primary font-medium hover:text-primary-fixed-dim transition-colors mb-6 text-sm">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Slider Listesine Dön
        </a>
        <h1 class="font-headline text-5xl font-bold tracking-tight text-on-surface mb-3">Slider Güncelle</h1>
        <p class="text-on-surface-variant text-lg">Mevcut slider içeriklerini düzenleyin.</p>
    </div>

    <!-- Form -->
    <div class="bg-surface-container-low rounded-xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <form asp-controller="Slider" asp-action="UpdateSlider" method="post"
              class="p-8 md:p-12 space-y-10">

            <input type="hidden" asp-for="SliderId" />

            <!-- Slider 1 -->
            <div class="space-y-6">
                <div class="flex items-center gap-4 pb-4 border-b border-outline-variant/40">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-fixed text-primary font-headline font-bold text-lg">1</span>
                    <h2 class="font-headline text-2xl font-semibold text-on-surface">Slider Bir</h2>
                </div>
                <div class="grid grid-cols-1 gap-6">
                    <div>
                        <label asp-for="Title1" class="block text-sm font-semibold text-on-surface mb-2">Başlık</label>
                        <input asp-for="Title1"
                               class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-primary transition-shadow font-body outline-none"
                               placeholder="Başlık giriniz" />
                        <span asp-validation-for="Title1" class="text-error text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Description1" class="block text-sm font-semibold text-on-surface mb-2">Açıklama</label>
                        <textarea asp-for="Description1" rows="3"
                                  class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-primary transition-shadow font-body resize-y outline-none"
                                  placeholder="Açıklama giriniz"></textarea>
                    </div>
                </div>
            </div>

            <!-- Slider 2 -->
            <div class="space-y-6 pt-6">
                <div class="flex items-center gap-4 pb-4 border-b border-outline-variant/40">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-fixed text-primary font-headline font-bold text-lg">2</span>
                    <h2 class="font-headline text-2xl font-semibold text-on-surface">Slider İki</h2>
                </div>
                <div class="grid grid-cols-1 gap-6">
                    <div>
                        <label asp-for="Title2" class="block text-sm font-semibold text-on-surface mb-2">Başlık</label>
                        <input asp-for="Title2"
                               class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-primary transition-shadow font-body outline-none"
                               placeholder="Başlık giriniz" />
                        <span asp-validation-for="Title2" class="text-error text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Description2" class="block text-sm font-semibold text-on-surface mb-2">Açıklama</label>
                        <textarea asp-for="Description2" rows="3"
                                  class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-primary transition-shadow font-body resize-y outline-none"
                                  placeholder="Açıklama giriniz"></textarea>
                    </div>
                </div>
            </div>

            <!-- Slider 3 -->
            <div class="space-y-6 pt-6">
                <div class="flex items-center gap-4 pb-4 border-b border-outline-variant/40">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-fixed text-primary font-headline font-bold text-lg">3</span>
                    <h2 class="font-headline text-2xl font-semibold text-on-surface">Slider Üç</h2>
                </div>
                <div class="grid grid-cols-1 gap-6">
                    <div>
                        <label asp-for="Title3" class="block text-sm font-semibold text-on-surface mb-2">Başlık</label>
                        <input asp-for="Title3"
                               class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-primary transition-shadow font-body outline-none"
                               placeholder="Başlık giriniz" />
                        <span asp-validation-for="Title3" class="text-error text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Description3" class="block text-sm font-semibold text-on-surface mb-2">Açıklama</label>
                        <textarea asp-for="Description3" rows="3"
                                  class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-primary transition-shadow font-body resize-y outline-none"
                                  placeholder="Açıklama giriniz"></textarea>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="pt-10 flex flex-col-reverse sm:flex-row items-center justify-end gap-4 border-t border-outline-variant/40">
                <a asp-controller="Slider" asp-action="SliderList"
                   class="w-full sm:w-auto px-8 py-3 rounded-lg border border-outline text-on-surface font-semibold hover:bg-surface-variant/50 transition-colors text-center">
                    Vazgeç
                </a>
                <button type="submit"
                        class="w-full sm:w-auto px-8 py-3 rounded-lg bg-primary text-on-primary font-semibold hover:bg-on-primary-fixed-variant transition-colors shadow-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">save</span>
                    Güncelle
                </button>
            </div>

        </form>
    </div>

</main>
