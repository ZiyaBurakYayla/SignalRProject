@using SignalRWebUI.Dtos.SliderDtos
@model List<ResultSliderDto>
@{
    ViewData["Title"] = "Slider Yönetimi";
}

<style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
</style>

<main class="admin-page">

    <!-- Header -->
    <header class="admin-header">
        <div>
            <p class="admin-badge">Sahara Admin</p>
            <h1 class="admin-title">Slider Yönetimi</h1>
            <p class="admin-subtitle">Web sitesindeki slider içeriklerini yönetin.</p>
        </div>
        <a asp-controller="Slider" asp-action="CreateSlider" class="admin-btn-add">
            <span class="material-symbols-outlined">add</span>
            Yeni Slider Ekle
        </a>
    </header>

    <!-- Bento Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var item in Model)
            {
                <article class="bg-surface-container-low rounded-xl p-8 border border-outline-variant/60 shadow-[0_2px_16px_rgba(58,48,42,0.04)] flex flex-col h-full hover:border-primary/30 transition-colors duration-300 relative group">

                    <!-- Edit / Delete -->
                    <div class="absolute top-4 right-4 flex opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                        <a asp-controller="Slider" asp-action="UpdateSlider" asp-route-id="@item.SliderId"
                           class="p-2 text-on-surface-variant hover:text-primary transition-colors" title="Düzenle">
                            <span class="material-symbols-outlined text-[20px]">edit</span>
                        </a>
                        <a asp-controller="Slider" asp-action="DeleteSlider" asp-route-id="@item.SliderId"
                           class="p-2 text-on-surface-variant hover:text-error transition-colors" title="Sil">
                            <span class="material-symbols-outlined text-[20px]">delete</span>
                        </a>
                    </div>

                    <!-- ID Badge -->
                    <div class="mb-6">
                        <span class="inline-block px-3 py-1 bg-surface-variant text-on-surface-variant text-xs font-semibold tracking-wider uppercase rounded-full">
                            Set ID: #SLD-@item.SliderId
                        </span>
                    </div>

                    <!-- Items -->
                    <div class="flex-grow space-y-6">
                        <div>
                            <h3 class="font-headline text-xl font-medium text-on-background mb-1">@item.Title1</h3>
                            <p class="text-sm text-on-surface-variant leading-relaxed">@item.Description1</p>
                        </div>
                        <hr class="border-t border-outline-variant/30" />
                        <div>
                            <h3 class="font-headline text-xl font-medium text-on-background mb-1">@item.Title2</h3>
                            <p class="text-sm text-on-surface-variant leading-relaxed">@item.Description2</p>
                        </div>
                        <hr class="border-t border-outline-variant/30" />
                        <div>
                            <h3 class="font-headline text-xl font-medium text-on-background mb-1">@item.Title3</h3>
                            <p class="text-sm text-on-surface-variant leading-relaxed">@item.Description3</p>
                        </div>
                    </div>

                </article>
            }
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center py-24 text-secondary gap-4">
            <span class="material-symbols-outlined text-[4rem] opacity-40">view_carousel</span>
            <p class="font-label text-sm">Henüz slider içeriği bulunmuyor.</p>
            <a asp-controller="Slider" asp-action="CreateSlider"
               class="inline-flex items-center gap-1.5 text-primary hover:underline text-sm font-medium">
                <span class="material-symbols-outlined text-[18px]">add</span>
                İlk seti ekleyin
            </a>
        </div>
    }

</main>
