@model CreateBookingDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("UILayoutHeadComponent")

<body class="sub_page">

    @await Component.InvokeAsync("MenuNavbarComponent")

    <section class="book_section layout_padding">
        <div class="container">
            <div class="heading_container">
                <h2>
                    Rezervasyon Oluşturun
                </h2>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form_container">
                        <form method="post">

                            <input type="hidden" asp-for="Description" value="Rezervasyon Beklemede" />
                            <div asp-validation-summary="All" class="text-danger"></div>

                            <div>
                                <input type="text" class="form-control" placeholder="Adınız Soyadınız" asp-for="Name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div>
                                <input type="tel" class="form-control" placeholder="Telefon Numaranız" asp-for="PhoneNO" />
                                <span asp-validation-for="PhoneNO" class="text-danger"></span>
                            </div>
                            <div>
                                <input type="email" class="form-control" placeholder="Mail Adresiniz" asp-for="Mail" />
                                <span asp-validation-for="Mail" class="text-danger"></span>
                            </div>
                            <div>
                                <select asp-for="PersonCount" class="form-control nice-select wide">
                                    <option value="" disabled selected>
                                        Kaç Kişisiziniz?
                                    </option>
                                    <option value="1">
                                        1
                                    </option>
                                    <option value="2">
                                        2
                                    </option>
                                    <option value="3">
                                        3
                                    </option>
                                    <option value="4">
                                        4
                                    </option>
                                    <option value="5">
                                        5
                                    </option>
                                    <option value="6">
                                        6++
                                    </option>
                                </select>
                                <span asp-validation-for="PersonCount" class="text-danger"></span>
                            </div>
                            <div>
                                <input type="date" class="form-control" asp-for="Date">
                                <span asp-validation-for="Date" class="text-danger"></span>
                            </div>
                            <div class="btn_box">
                                <button>
                                    Yerinizi Ayırtın
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="map_container">
                        @if (!string.IsNullOrEmpty(ViewBag.Location as string))
                        {
                            <iframe src="@ViewBag.Location" width="600" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        }
                        else
                        {
                            <div id="googleMap" style="width:100%;height:400px;background:#f0ede8;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                                <span style="color:#9a8c85;font-size:14px;">Harita yüklenemedi</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Component.InvokeAsync("UILayoutFooterComponent")

    @await Component.InvokeAsync("UILayoutScriptComponent")

</body>

</html>
