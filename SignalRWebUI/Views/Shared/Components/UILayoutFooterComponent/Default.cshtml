@model List<ResultContactDto>
@foreach (var item in Model)
{
    <footer class="footer_section">
        <div class="container">
            <div class="row">
                <div class="col-md-4 footer-col">
                    <div class="footer_contact">
                        <h4>Bize Ulaşın</h4>
                        @{
                            string loc = item.Location ?? "";
                            string mapLink = loc.StartsWith("http")
                                ? loc.Replace("&output=embed", "").Replace("?output=embed", "")
                                : "https://www.google.com/maps?q=" + Uri.EscapeDataString(loc);
                        }
                        <div class="contact_link_box">
                            <a href="@mapLink" target="_blank" rel="noopener">
                                <i class="fa fa-map-marker" aria-hidden="true"></i>
                                <span>Konumumuzu Haritada Görün</span>
                            </a>
                            <a href="tel:@item.Phone">
                                <i class="fa fa-phone" aria-hidden="true"></i>
                                <span>@item.Phone</span>
                            </a>
                            <a href="mailto:@item.Email">
                                <i class="fa fa-envelope" aria-hidden="true"></i>
                                <span>@item.Email</span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 footer-col">
                    <div class="footer_detail">
                        <a href="/Default/Index/" class="footer-logo">
                            @item.FooterTitle
                        </a>
                        <p>@item.FooterDescription</p>
                        @await Component.InvokeAsync("UILayoutSocialMediaComponent")
                    </div>
                </div>
                <div class="col-md-4 footer-col">
                    <h4>@item.OpenDays</h4>
                    <p>@item.OpenDaysDescription</p>
                    <p>@item.OpenHours</p>
                </div>
            </div>
            <div class="footer-info">
                <p>
                    &copy; <span id="displayYear"></span> Tüm Hakları Saklıdır.
                    <a href="#">Sahara Restoran</a>
                </p>
            </div>
        </div>
    </footer>
}
