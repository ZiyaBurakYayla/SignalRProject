<section class="book_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>Rezervasyon Oluşturun</h2>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form_container">
                    <form method="post" action="/BookATable/Index">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Description" value="Rezervasyon Beklemede" />

                        <div>
                            <input type="text" class="form-control" placeholder="Adınız Soyadınız" name="Name" />
                        </div>
                        <div>
                            <input type="tel" class="form-control" placeholder="Telefon Numaranız" name="PhoneNO" />
                        </div>
                        <div>
                            <input type="email" class="form-control" placeholder="Mail Adresiniz" name="Mail" />
                        </div>
                        <div>
                            <select class="form-control nice-select wide" name="PersonCount">
                                <option value="" disabled selected>Kaç Kişisiniz?</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6++</option>
                            </select>
                        </div>
                        <div>
                            <input type="date" class="form-control" name="Date" />
                        </div>
                        <div class="btn_box">
                            <button type="submit">Yerinizi Ayırtın</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-md-6">
                <div class="map_container">
                    @if (!string.IsNullOrEmpty(ViewBag.Location as string))
                    {
                        <iframe src="@ViewBag.Location" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    }
                    else
                    {
                        <div id="googleMap" style="width:100%;height:450px;background:#f0ede8;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                            <span style="color:#9a8c85;font-size:14px;">Harita yüklenemedi</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
